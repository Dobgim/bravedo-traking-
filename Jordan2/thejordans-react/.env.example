VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# Google Maps JavaScript API key for the live tracking map (used when the key
# in Admin -> Settings is empty). Needs the Maps JavaScript, Geocoding and
# Directions APIs. Restrict it to your domains in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
